# Copy this file to `.env` and fill in your real values.
# All four providers below are OpenAI-compatible, so the openai Python SDK
# works with all of them — you only change base_url and the model name.

# -------- Pick a provider --------
# Option A — OpenRouter (https://openrouter.ai)
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# JUNO_MODEL=meta-llama/llama-3.1-70b-instruct

# Option B — Groq (https://console.groq.com)
# OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# JUNO_MODEL=llama-3.1-70b-versatile

# Option C — Ollama Cloud (https://ollama.com)
# OPENAI_API_KEY=ollama_xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://ollama.com/v1
# JUNO_MODEL=llama3.1

# Option D — Gemini (OpenAI-compatible endpoint)
# OPENAI_API_KEY=AIzaSyxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUNO_MODEL=gemini-1.5-flash

# -------- Filled-in example (uncomment & replace) --------
OPENAI_API_KEY=sk-or-v1-REPLACE_ME
OPENAI_BASE_URL=https://openrouter.ai/api/v1
JUNO_MODEL=meta-llama/llama-3.1-70b-instruct

# Safety: how many files a tool may touch before asking for confirmation.
JUNO_DESTRUCTIVE_THRESHOLD=5

# Currency label shown next to expense amounts. Display only — Juno never
# converts between currencies.
JUNO_CURRENCY=PKR
